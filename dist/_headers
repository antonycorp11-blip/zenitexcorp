# Só o ATHG (e o próprio jogo / dev local) pode exibir o jogo em iframe.
/*
  Content-Security-Policy: frame-ancestors 'self' https://athg.antonycorp11.workers.dev http://localhost:*
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
